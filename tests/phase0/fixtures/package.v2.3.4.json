{
  "name": "desktop-mascot-ui",
  "productName": "Desktop Mascot",
  "version": "2.3.4",
  "description": "A transparent desktop mascot with never-lost screen recovery, verified live apply, effect preview, and no-code image editing",
  "author": "YOUR NAME",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-config.js",
    "build:mac": "npm run check && electron-builder --mac --publish never",
    "build:mac:arm64": "npm run check && electron-builder --mac --arm64 --publish never",
    "build:mac:x64": "npm run check && electron-builder --mac --x64 --publish never",
    "build:mac:universal": "npm run check && electron-builder --mac --universal --publish never"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.example.desktopmascot",
    "productName": "Desktop Mascot",
    "asar": true,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "settings.html",
      "settings.css",
      "settings.js",
      "characters/default/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  }
}
